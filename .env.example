# Laravel Content API, called server-to-server only (never exposed to the browser).
CONTENT_API_URL=http://localhost:8000
CONTENT_API_KEY=

# Laravel origin for the booking/payment proxy (/api/booking/*, /api/payment/*, /payment/sepay/form).
# Only used where Nginx doesn't route those paths to Laravel (local development). Falls back to
# CONTENT_API_URL when empty. Read at build time (next.config.ts rewrites).
LARAVEL_ORIGIN=http://localhost:8000

# Public origin of the site, used for canonical URLs, sitemap and JSON-LD.
SITE_URL=https://greenrubycruises.com

# Where /upload and /thumbnail are served from. Empty in production (same origin via Nginx);
# set to the Laravel origin in local development, e.g. http://localhost:8000
NEXT_PUBLIC_MEDIA_ORIGIN=

# Shared secret Laravel sends to POST /api/revalidate after content changes.
REVALIDATE_SECRET=

# Shared secret the CMS sends (X-Manifest-Key) when it pulls GET /api/i18n/manifest from each web instance to check
# which languages this build serves (locale readiness). Empty: the endpoint answers 503 and no new language can go public.
FRONTEND_MANIFEST_SECRET=
# Authenticated preview (phase 1E-d): shared with the CMS (CONTENT_PREVIEW_KEY there too), different from
# CONTENT_API_KEY. The CMS posts single-use tokens to /_draft/enter; without this key preview is off.
CONTENT_PREVIEW_KEY=
