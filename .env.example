# Laravel Content API, called server-to-server only (never exposed to the browser).
CONTENT_API_URL=http://localhost:8000
CONTENT_API_KEY=

# Public origin of the site, used for canonical URLs, sitemap and JSON-LD.
SITE_URL=https://greenrubycruises.com

# Where /upload and /thumbnail are served from. Empty in production (same origin via Nginx);
# set to the Laravel origin in local development, e.g. http://localhost:8000
NEXT_PUBLIC_MEDIA_ORIGIN=

# Shared secret Laravel sends to POST /api/revalidate after content changes.
REVALIDATE_SECRET=
