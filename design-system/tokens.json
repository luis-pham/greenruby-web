{
  "$description": "Green Ruby Cruises design tokens (DTCG format). Source of truth: run `node design-system/build-tokens.mjs` to regenerate tokens.css and tokens.ts. Derived from the 11 redesign pages in /new_website, normalized (near-duplicate hex values merged, contrast fixed to WCAG AA).",

  "color": {
    "$type": "color",
    "green": {
      "950": { "$value": "#0c2826", "$description": "deep — footer, dark sections (merges #0d2c29, #0c2925)" },
      "900": { "$value": "#123a35", "$description": "forest — primary brand, headings on light" },
      "800": { "$value": "#204840", "$description": "forest2 — hover/raised surfaces on dark" },
      "700": { "$value": "#2c4b45" },
      "100": { "$value": "#e1e5dc", "$description": "cool line / FAQ dividers" },
      "50":  { "$value": "#eaf1ea", "$description": "text on dark" }
    },
    "neutral": {
      "ink":     { "$value": "#273a35", "$description": "body text (10.9:1 on cream)" },
      "muted":   { "$value": "#5f6a63", "$description": "secondary text — darkened from #6d7770 to pass AA on cream & ivory" },
      "line":    { "$value": "#e2e0d7" },
      "line-strong": { "$value": "#cbcbbf" },
      "white":   { "$value": "#ffffff" },
      "paper":   { "$value": "#fffefa" },
      "cream":   { "$value": "#f7f4ed", "$description": "page background" },
      "sand":    { "$value": "#f7f1e7", "$description": "nav booking button" },
      "ivory":   { "$value": "#eee8db", "$description": "alt section background" }
    },
    "gold": {
      "300": { "$value": "#e0c499", "$description": "gold-bright — accents on dark" },
      "200": { "$value": "#d5c3a0", "$description": "gold-soft" },
      "500": { "$value": "#bb9e70", "$description": "brand gold — buttons, decoration. NOT for text on light (2.3:1)" },
      "700": { "$value": "#806c4b", "$description": "gold for text on light backgrounds (4.6:1 on cream)" }
    },
    "red": {
      "50":  { "$value": "#fbf0ed", "$description": "error surface" },
      "300": { "$value": "#cfaca4", "$description": "error border" },
      "700": { "$value": "#8f5047", "$description": "error text (6.1:1 on red.50)" }
    },
    "overlay": {
      "hero":   { "$value": "rgba(5, 28, 29, 0.72)" },
      "soft":   { "$value": "rgba(5, 28, 29, 0.22)" },
      "strong": { "$value": "rgba(4, 28, 28, 0.88)" }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "serif": { "$value": ["Playfair Display", "Georgia", "serif"] },
      "sans":  { "$value": ["DM Sans", "Arial", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "$description": "Design used 7–10px labels heavily; floor raised to 11px for legibility/Lighthouse.",
      "label":    { "$value": "11px", "$description": "eyebrow, buttons, nav (uppercase, tracked)" },
      "xs":       { "$value": "12px" },
      "sm":       { "$value": "13px", "$description": "card copy" },
      "base":     { "$value": "15px", "$description": "body / article copy" },
      "md":       { "$value": "17px" },
      "lg":       { "$value": "21px", "$description": "h4, lead" },
      "xl":       { "$value": "clamp(24px, 2.6vw, 36px)", "$description": "h3 / card title" },
      "2xl":      { "$value": "clamp(34px, 4vw, 55px)", "$description": "h2 / section heading" },
      "3xl":      { "$value": "clamp(40px, 5.3vw, 71px)", "$description": "CTA banner heading" },
      "display":  { "$value": "clamp(46px, 6.2vw, 95px)", "$description": "hero h1" }
    },
    "leading": {
      "$type": "number",
      "none":   { "$value": 1 },
      "tight":  { "$value": 1.12 },
      "snug":   { "$value": 1.2 },
      "normal": { "$value": 1.6 },
      "relaxed":{ "$value": 1.85, "$description": "body copy (design range 1.8–1.95)" }
    },
    "tracking": {
      "$type": "dimension",
      "display": { "$value": "-0.035em" },
      "heading": { "$value": "-0.023em" },
      "normal":  { "$value": "0" },
      "wide":    { "$value": "0.14em", "$description": "buttons, nav" },
      "wider":   { "$value": "0.2em",  "$description": "eyebrow, footer headings" }
    }
  },

  "space": {
    "$type": "dimension",
    "$description": "4px base. Design values (7,13,17,19,22,27…) snap to the nearest step.",
    "0":  { "$value": "0" },
    "1":  { "$value": "4px" },
    "2":  { "$value": "8px" },
    "3":  { "$value": "12px" },
    "4":  { "$value": "16px" },
    "5":  { "$value": "20px" },
    "6":  { "$value": "24px" },
    "7":  { "$value": "28px" },
    "8":  { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "14": { "$value": "56px" },
    "18": { "$value": "72px" },
    "24": { "$value": "96px" },
    "section-y": { "$value": "clamp(72px, 9vw, 120px)", "$description": "vertical section padding (design: 75–122px)" },
    "gutter":    { "$value": "clamp(20px, 3.6vw, 46px)", "$description": "container side padding" }
  },

  "size": {
    "$type": "dimension",
    "container":  { "$value": "1300px" },
    "prose":      { "$value": "720px", "$description": "article body" },
    "copy":       { "$value": "560px", "$description": "section intro paragraph" },
    "nav-height": { "$value": "96px" },
    "nav-height-mobile": { "$value": "79px" },
    "control":    { "$value": "52px", "$description": "button min-height" },
    "control-sm": { "$value": "44px" }
  },

  "radius": {
    "$type": "dimension",
    "$description": "The design is deliberately square-edged.",
    "none": { "$value": "0" },
    "sm":   { "$value": "4px" },
    "md":   { "$value": "6px" },
    "pill": { "$value": "999px" },
    "full": { "$value": "50%" }
  },

  "shadow": {
    "$type": "shadow",
    "sm": { "$value": "0 12px 25px rgba(12, 40, 38, 0.08)" },
    "md": { "$value": "0 21px 45px rgba(20, 48, 37, 0.11)" },
    "lg": { "$value": "0 25px 80px rgba(0, 0, 0, 0.3)" }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "200ms", "$description": "color/background hover" },
      "base": { "$value": "250ms", "$description": "card lift" },
      "slow": { "$value": "650ms", "$description": "image zoom on hover" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.25, 0.1, 0.25, 1] },
      "out":      { "$value": [0.18, 0.8, 0.2, 1] }
    }
  },

  "breakpoint": {
    "$type": "dimension",
    "$description": "Design had ~25 ad-hoc breakpoints (360–1250px); normalized to 4. Use as max-width queries.",
    "sm": { "$value": "600px" },
    "md": { "$value": "900px" },
    "lg": { "$value": "1160px" },
    "xl": { "$value": "1600px", "$description": "min-width only" }
  },

  "z": {
    "$type": "number",
    "base":    { "$value": 1 },
    "nav":     { "$value": 50 },
    "overlay": { "$value": 90 },
    "modal":   { "$value": 100 },
    "toast":   { "$value": 110 }
  },

  "semantic": {
    "$description": "Components use ONLY these (plus font/space/radius/motion). Primitives above are not referenced directly in components.",
    "bg": {
      "$type": "color",
      "page":        { "$value": "{color.neutral.cream}" },
      "surface":     { "$value": "{color.neutral.white}" },
      "surface-alt": { "$value": "{color.neutral.ivory}" },
      "inverse":     { "$value": "{color.green.950}" },
      "brand":       { "$value": "{color.green.900}" },
      "brand-hover": { "$value": "{color.green.800}" },
      "overlay":     { "$value": "{color.overlay.hero}" },
      "raised":      { "$value": "{color.neutral.paper}", "$description": "form panels on cream" },
      "success":     { "$value": "{color.green.50}" },
      "danger":      { "$value": "{color.red.50}" }
    },
    "text": {
      "$type": "color",
      "body":           { "$value": "{color.neutral.ink}" },
      "heading":        { "$value": "{color.green.900}" },
      "muted":          { "$value": "{color.neutral.muted}" },
      "accent":         { "$value": "{color.gold.700}" },
      "inverse":        { "$value": "{color.green.50}" },
      "inverse-accent": { "$value": "{color.gold.300}" },
      "on-accent":      { "$value": "#152c27" },
      "danger":         { "$value": "{color.red.700}" }
    },
    "border": {
      "$type": "color",
      "default": { "$value": "{color.neutral.line}" },
      "strong":  { "$value": "{color.neutral.line-strong}" },
      "inverse": { "$value": "rgba(255, 255, 255, 0.22)" },
      "danger":  { "$value": "{color.red.300}" }
    },
    "action": {
      "$type": "color",
      "primary":       { "$value": "{color.gold.500}" },
      "primary-hover": { "$value": "{color.gold.300}" },
      "secondary":     { "$value": "{color.neutral.white}" },
      "focus":         { "$value": "{color.gold.700}" }
    }
  }
}
